<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Mangosteen</AssemblyName>
    <RootNamespace>Mangosteen</RootNamespace>
    <ApplicationIcon>Assets\Mangosteen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Mangosteen.Program</StartupObject>
    <!-- A tray app is idle most of the time: no background GC thread. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- DPI awareness is declared in app.manifest for the WPF app; the WinForms analyzer would prefer an API call. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No single-file compression: a compressed bundle is unpacked into memory at start (about 200 MB idle instead
         of about 75 MB). The release zips the exe instead, so the download stays the same size. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, Point, MessageBox); WinForms is only used for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="Mangosteen.Core.Loc" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Mangosteen.ico" />
    <EmbeddedResource Include="Assets\Mangosteen.ico" LogicalName="Mangosteen.ico" />
    <!-- The demo in the welcome window; MediaElement plays only files, so it is written out on first use. -->
    <EmbeddedResource Include="Assets\welcome-demo.mp4" LogicalName="welcome-demo.mp4" />
    <!-- FFmpeg (GPLv3) is bundled when build/fetch-ffmpeg.ps1 has run: the archive lives in Mangosteen.FFmpeg.dll, and
         its hash is recorded here so Mangosteen knows about it without loading that assembly. -->
    <AssemblyMetadata Include="FFmpegHash" Value="$(FFmpegHash)" Condition="'$(FFmpegHash)' != ''" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)Media\ffmpeg.sha256')">
    <FFmpegHash>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Media\ffmpeg.sha256').Trim())</FFmpegHash>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mangosteen.FFmpeg\Mangosteen.FFmpeg.csproj" />
    <ProjectReference Include="..\Mangosteen.Core\Mangosteen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mangosteen.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- PDFsharp 6.5 and later are AGPL-3.0; 6.2.x is the last MIT release. Do not upgrade. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>
  <!-- Native packages ship their own .pdb files; the published app is Mangosteen.exe alone. -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
